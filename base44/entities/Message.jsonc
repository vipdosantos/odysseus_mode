{
  "name": "Message",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "description": "Canal: 'geral' para grupo, ou 'dm:idA:idB' (ids ordenados) para conversa direta"
    },
    "sender_id": {
      "type": "string",
      "description": "ID do remetente"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "content": {
      "type": "string",
      "description": "Conte\u00fado da mensagem (texto ou legenda da foto)"
    },
    "attachment_url": {
      "type": "string",
      "description": "URL da imagem anexada (foto)"
    },
    "seen": {
      "type": "boolean",
      "default": false,
      "description": "Mensagem j\u00e1 foi vista por algum destinat\u00e1rio (define se pode editar/apagar)"
    }
  },
  "required": [
    "channel",
    "sender_id"
  ]
}