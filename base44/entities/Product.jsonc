{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do produto"
    },
    "size": {
      "type": "string",
      "description": "Tamanho / Dimens\u00e3o"
    },
    "unit": {
      "type": "string",
      "description": "Unidade (un, m, kg...)",
      "default": "un"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o unit\u00e1rio",
      "default": 0
    },
    "stock": {
      "type": "number",
      "description": "Estoque atual",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "description": "Estoque m\u00ednimo",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "trelica",
        "madeira",
        "ferro",
        "outros"
      ],
      "default": "trelica",
      "description": "Categoria"
    },
    "active": {
      "type": "boolean",
      "description": "Ativo",
      "default": true
    },
    "consumo_insumos": {
      "type": "array",
      "description": "Consumo de insumos por unidade do produto (BOM)",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "type": "string",
            "description": "ID do insumo (Supply)"
          },
          "supply_name": {
            "type": "string",
            "description": "Nome do insumo"
          },
          "quantity": {
            "type": "number",
            "default": 0,
            "description": "Quantidade consumida por unidade"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name"
  ]
}