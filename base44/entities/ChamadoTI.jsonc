{
  "name": "ChamadoTI",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo resumido do problema"
    },
    "solicitante_nome": {
      "type": "string",
      "description": "Nome de quem abriu o chamado"
    },
    "solicitante_email": {
      "type": "string",
      "description": "E-mail do solicitante"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "hardware",
        "software",
        "rede",
        "impressora",
        "periferico",
        "outros"
      ],
      "default": "hardware",
      "description": "Categoria do chamado"
    },
    "equipamento": {
      "type": "string",
      "description": "Equipamento envolvido (hostname, tag, modelo)"
    },
    "local": {
      "type": "string",
      "description": "Local/setor do equipamento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do problema (o que aconteceu)"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_andamento",
        "resolvido",
        "fechado"
      ],
      "default": "aberto"
    },
    "tecnico_nome": {
      "type": "string",
      "description": "T\u00e9cnico respons\u00e1vel pelo atendimento"
    },
    "solucao": {
      "type": "string",
      "description": "Solu\u00e7\u00e3o aplicada / diagn\u00f3stico"
    },
    "resolvido_em": {
      "type": "string",
      "format": "date",
      "description": "Data de resolu\u00e7\u00e3o"
    }
  },
  "required": [
    "titulo",
    "solicitante_nome",
    "categoria"
  ]
}