{
  "name": "Projeto",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "client_name": {
      "type": "string",
      "description": "Cliente"
    },
    "floor_plan_url": {
      "type": "string",
      "description": "URL da planta importada (fundo)"
    },
    "scale_px_per_m": {
      "type": "number",
      "default": 100,
      "description": "Pixels por metro (calibra\u00e7\u00e3o de escala)"
    },
    "floor_plan_opacity": {
      "type": "number",
      "default": 0.5,
      "description": "Opacidade da planta de fundo (0-1)"
    },
    "show_grid": {
      "type": "boolean",
      "default": true,
      "description": "Exibir malha (grade)"
    },
    "plano_escoras": {
      "type": "boolean",
      "default": false,
      "description": "Modo de visualiza\u00e7\u00e3o: Plano de Escoras"
    },
    "slabs": {
      "type": "array",
      "default": [],
      "description": "Lajes desenhadas (pol\u00edgonos)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "Identificador (L1, L2...)"
          },
          "vertices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          },
          "area_m2": {
            "type": "number",
            "default": 0,
            "description": "\u00c1rea calculada em m\u00b2"
          },
          "negativo": {
            "type": "boolean",
            "default": false,
            "description": "Negativo (abertura/v\u00e3o) \u2014 exclu\u00eddo da \u00e1rea total"
          },
          "tipo_laje": {
            "type": "string",
            "enum": [
              "Laje",
              "Painel",
              "Mista",
              "Laje Treli\u00e7ada Intereixo"
            ],
            "default": "Laje"
          },
          "tipo_enchimento": {
            "type": "string",
            "enum": [
              "Nenhum",
              "EPS",
              "Lajota",
              "EPS+Lajota"
            ],
            "default": "Nenhum"
          },
          "truss_type": {
            "type": "string",
            "enum": [
              "H8",
              "H12",
              "H16",
              "H20",
              "H25",
              "H30"
            ],
            "description": "Tipo de treli\u00e7a"
          },
          "direction": {
            "type": "object",
            "description": "Dire\u00e7\u00e3o das vigotas (vetor no canvas)",
            "properties": {
              "x1": {
                "type": "number"
              },
              "y1": {
                "type": "number"
              },
              "x2": {
                "type": "number"
              },
              "y2": {
                "type": "number"
              }
            }
          },
          "vt": {
            "type": "number",
            "default": 0,
            "description": "N\u00famero de vigotas (calculado pela dire\u00e7\u00e3o)"
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "default": [],
      "description": "Elementos gr\u00e1ficos/estruturais sobre a planta",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "linha",
              "tracejada",
              "ponto_luz",
              "vigota",
              "nervura",
              "nucleo",
              "frigideira",
              "negativo"
            ]
          },
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "diametro": {
            "type": "string",
            "description": "Di\u00e2metro da barra negativa (mm)"
          },
          "espacamento": {
            "type": "number",
            "default": 0,
            "description": "Espa\u00e7amento entre barras negativas (cm)"
          },
          "transpasse": {
            "type": "number",
            "default": 0,
            "description": "Transpasse/ancoragem nas pontas (cm)"
          },
          "comprimento": {
            "type": "number",
            "default": 0,
            "description": "Comprimento da barra negativa (m)"
          },
          "tipo_aco": {
            "type": "string",
            "enum": [
              "CA50",
              "CA60"
            ],
            "description": "Tipo de a\u00e7o da barra negativa"
          },
          "bitola": {
            "type": "string",
            "description": "Bitola (mm)"
          },
          "quantidade": {
            "type": "number",
            "default": 0,
            "description": "Quantidade de barras"
          },
          "acabamento": {
            "type": "string",
            "enum": [
              "reto",
              "com_dobra"
            ],
            "description": "Acabamento das pontas"
          },
          "dobra_esq": {
            "type": "number",
            "default": 0,
            "description": "Dobra esquerda (cm)"
          },
          "dobra_dir": {
            "type": "number",
            "default": 0,
            "description": "Dobra direita (cm)"
          },
          "igualar_dobras": {
            "type": "boolean",
            "default": false,
            "description": "Igualar dobras"
          }
        }
      }
    },
    "cotas": {
      "type": "array",
      "default": [],
      "description": "Cotas (linhas de dimens\u00e3o medidas)",
      "items": {
        "type": "object",
        "properties": {
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          },
          "meters": {
            "type": "number",
            "description": "Dist\u00e2ncia real medida (m)"
          }
        }
      }
    },
    "textos": {
      "type": "array",
      "default": [],
      "description": "Textos/etiquetas posicionados no canvas",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "total_area_m2": {
      "type": "number",
      "default": 0,
      "description": "\u00c1rea total (calculada)"
    },
    "seller_id": {
      "type": "string",
      "description": "Vendedor"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "order_id": {
      "type": "string",
      "description": "Or\u00e7amento/pedido gerado a partir do projeto"
    }
  },
  "required": [
    "name"
  ]
}