{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "operador",
        "financeiro",
        "vendedor",
        "visualizador"
      ],
      "default": "visualizador",
      "description": "Fun\u00e7\u00e3o do usu\u00e1rio no sistema"
    },
    "department": {
      "type": "string",
      "description": "Departamento"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "permissions": {
      "type": "object",
      "description": "Permiss\u00f5es por tela: path -> 'oculto' | 'ver' | 'editar'. Vazio usa o padr\u00e3o da fun\u00e7\u00e3o (role).",
      "default": {}
    },
    "assigned_stage": {
      "type": "string",
      "description": "Etapa do Kanban que este usu\u00e1rio \u00e9 respons\u00e1vel (chave da KanbanColumn). Define o status que o Scanner QR aplica ao bipar."
    }
  },
  "required": [
    "department",
    "phone"
  ]
}