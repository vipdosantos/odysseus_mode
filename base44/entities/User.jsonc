{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "operador",
        "financeiro",
        "visualizador"
      ],
      "default": "visualizador",
      "description": "Fun\u00e7\u00e3o do usu\u00e1rio no sistema"
    },
    "department": {
      "type": "string",
      "description": "Departamento"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    }
  },
  "required": [
    "department",
    "phone"
  ]
}