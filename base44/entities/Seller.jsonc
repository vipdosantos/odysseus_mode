{
  "name": "Seller",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "commission_rate": {
      "type": "number",
      "description": "Taxa de comiss\u00e3o (%)",
      "default": 0
    },
    "tabela_nome": {
      "type": "string",
      "description": "Nome da tabela de pre\u00e7os (ex: TABELA 29)"
    },
    "active": {
      "type": "boolean",
      "description": "Ativo",
      "default": true
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name"
  ]
}