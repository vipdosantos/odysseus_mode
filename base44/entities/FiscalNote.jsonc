{
  "name": "FiscalNote",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID do pedido"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero do pedido"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero da nota"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "nfs",
        "nfe"
      ],
      "default": "nfs"
    },
    "natureza": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o",
      "default": "Venda de Mercadoria"
    },
    "cfop": {
      "type": "string",
      "default": "5.102"
    },
    "descricao": {
      "type": "string"
    },
    "valor": {
      "type": "number",
      "default": 0
    },
    "aliquota_iss": {
      "type": "number",
      "default": 5
    },
    "cliente_cnpj": {
      "type": "string"
    },
    "cliente_ie": {
      "type": "string"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "emitida",
        "cancelada"
      ],
      "default": "rascunho"
    }
  },
  "required": [
    "order_number",
    "numero",
    "valor"
  ]
}