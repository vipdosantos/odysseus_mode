{
  "name": "Asset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do bem"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo patrim\u00f4nio"
    },
    "category": {
      "type": "string",
      "enum": [
        "maquina",
        "veiculo",
        "ferramenta",
        "movel",
        "eletronico",
        "outros"
      ],
      "default": "outros"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date",
      "description": "Data de aquisi\u00e7\u00e3o"
    },
    "acquisition_value": {
      "type": "number",
      "description": "Valor de aquisi\u00e7\u00e3o",
      "default": 0
    },
    "current_value": {
      "type": "number",
      "description": "Valor atual",
      "default": 0
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o"
    },
    "responsible": {
      "type": "string",
      "description": "Respons\u00e1vel"
    },
    "condition": {
      "type": "string",
      "enum": [
        "otimo",
        "bom",
        "regular",
        "ruim",
        "inativo"
      ],
      "default": "bom"
    },
    "serial_number": {
      "type": "string",
      "description": "N\u00ba de s\u00e9rie"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "code"
  ]
}