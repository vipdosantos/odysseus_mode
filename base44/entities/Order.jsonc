{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero do pedido"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "client_photo": {
      "type": "string",
      "description": "Foto do cliente (URL)"
    },
    "access_key": {
      "type": "string",
      "description": "Chave de acesso ao status do pedido"
    },
    "seller_id": {
      "type": "string",
      "description": "ID do vendedor"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "seller_phone": {
      "type": "string",
      "description": "Telefone do vendedor"
    },
    "status": {
      "type": "string",
      "enum": [
        "of_etiquetas",
        "corte_vigas",
        "producao",
        "secagem",
        "expedicao",
        "aguardando_entrega",
        "entrega",
        "a_caminho",
        "recebido",
        "pagamento_pendente",
        "finalizado"
      ],
      "default": "of_etiquetas"
    },
    "items": {
      "type": "array",
      "description": "Itens do pedido (treli\u00e7as)",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "truss_type": {
            "type": "string",
            "enum": [
              "H8",
              "H12",
              "H16",
              "H20",
              "H25",
              "H30"
            ],
            "description": "Tipo de treli\u00e7a"
          },
          "quantity": {
            "type": "number"
          },
          "produced": {
            "type": "number",
            "default": 0
          },
          "qr_code_id": {
            "type": "string"
          }
        }
      }
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_address": {
      "type": "string",
      "description": "Endere\u00e7o de entrega"
    },
    "delivery_lat": {
      "type": "number",
      "description": "Latitude"
    },
    "delivery_lng": {
      "type": "number",
      "description": "Longitude"
    },
    "truck_type": {
      "type": "string",
      "enum": [
        "nenhum",
        "moto",
        "van",
        "toco",
        "truck",
        "carreta",
        "bitrem"
      ],
      "default": "nenhum",
      "description": "Tipo de caminh\u00e3o"
    },
    "total_value": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "boleto",
        "pix",
        "transferencia",
        "cartao",
        "dinheiro",
        "cheque"
      ],
      "default": "boleto",
      "description": "Forma de pagamento"
    },
    "installments": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de parcelas"
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "normal",
        "alta",
        "urgente"
      ],
      "default": "normal"
    },
    "attachments": {
      "type": "array",
      "description": "Anexos",
      "items": {
        "type": "string"
      }
    },
    "delivery_photos": {
      "type": "array",
      "description": "Fotos da entrega",
      "items": {
        "type": "string"
      }
    },
    "delivery_signature": {
      "type": "string",
      "description": "Assinatura do recebedor (base64 PNG)"
    },
    "delivery_signed_by": {
      "type": "string",
      "description": "Nome do recebedor"
    },
    "delivery_signer_doc": {
      "type": "string",
      "description": "CPF/RG do recebedor"
    },
    "delivery_signed_at": {
      "type": "string",
      "description": "Data/hora da assinatura"
    }
  },
  "required": [
    "order_number",
    "client_name"
  ]
}