{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero do pedido"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "client_photo": {
      "type": "string",
      "description": "Foto do cliente (URL)"
    },
    "access_key": {
      "type": "string",
      "description": "Chave de acesso ao status do pedido"
    },
    "seller_id": {
      "type": "string",
      "description": "ID do vendedor"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "seller_phone": {
      "type": "string",
      "description": "Telefone do vendedor"
    },
    "status": {
      "type": "string",
      "default": "of_etiquetas",
      "description": "Etapa do pedido (chave da coluna Kanban)"
    },
    "items": {
      "type": "array",
      "description": "Itens do pedido (treli\u00e7as)",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "truss_type": {
            "type": "string",
            "enum": [
              "H8",
              "H12",
              "H16",
              "H20",
              "H25",
              "H30"
            ],
            "description": "Tipo de treli\u00e7a"
          },
          "quantity": {
            "type": "number"
          },
          "produced": {
            "type": "number",
            "default": 0
          },
          "scanned_units": {
            "type": "array",
            "description": "Unidades j\u00e1 escaneadas na produ\u00e7\u00e3o (n\u00fameros 1..quantity)",
            "items": {
              "type": "number"
            }
          },
          "delivered_units": {
            "type": "array",
            "description": "Unidades conferidas na entrega (n\u00fameros 1..quantity)",
            "items": {
              "type": "number"
            }
          },
          "stage_conferencias": {
            "type": "object",
            "description": "Confer\u00eancia por etapa do Kanban: stageKey -> [unidades bipadas]. Cada status exige bipe de todas as unidades para avan\u00e7ar.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "default": {}
          },
          "qr_code_id": {
            "type": "string"
          },
          "adicionais": {
            "type": "array",
            "description": "Ferros adicionais",
            "items": {
              "type": "object",
              "properties": {
                "diametro": {
                  "type": "string",
                  "enum": [
                    "5.0",
                    "6.3",
                    "8.0",
                    "12.5"
                  ],
                  "description": "Di\u00e2metro do ferro"
                },
                "quantity": {
                  "type": "number",
                  "default": 0
                }
              }
            }
          }
        }
      }
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_address": {
      "type": "string",
      "description": "Endere\u00e7o de entrega"
    },
    "delivery_lat": {
      "type": "number",
      "description": "Latitude"
    },
    "delivery_lng": {
      "type": "number",
      "description": "Longitude"
    },
    "truck_type": {
      "type": "string",
      "default": "nenhum",
      "description": "C\u00f3digo do tipo de caminh\u00e3o (vinculado ao cadastro TruckType)"
    },
    "total_value": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "boleto",
        "pix",
        "transferencia",
        "cartao",
        "dinheiro",
        "cheque"
      ],
      "default": "boleto",
      "description": "Forma de pagamento"
    },
    "installments": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de parcelas"
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "normal",
        "alta",
        "urgente"
      ],
      "default": "normal"
    },
    "attachments": {
      "type": "array",
      "description": "Anexos",
      "items": {
        "type": "string"
      }
    },
    "delivery_photos": {
      "type": "array",
      "description": "Fotos da entrega",
      "items": {
        "type": "string"
      }
    },
    "delivery_signature": {
      "type": "string",
      "description": "Assinatura do recebedor (base64 PNG)"
    },
    "delivery_signed_by": {
      "type": "string",
      "description": "Nome do recebedor"
    },
    "delivery_signer_doc": {
      "type": "string",
      "description": "CPF/RG do recebedor"
    },
    "delivery_signed_at": {
      "type": "string",
      "description": "Data/hora da assinatura"
    },
    "delivery_conferido": {
      "type": "boolean",
      "default": false,
      "description": "Confer\u00eancia de entrega conclu\u00edda (todas as treli\u00e7as bipadas)"
    },
    "delivery_conferido_at": {
      "type": "string",
      "description": "Data/hora da confer\u00eancia de entrega"
    },
    "delivery_conferido_by": {
      "type": "string",
      "description": "Quem fez a confer\u00eancia de entrega"
    },
    "scan_log": {
      "type": "array",
      "description": "Log detalhado de cada bipagem (rastreio por etapa)",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "description": "Chave da etapa do Kanban"
          },
          "stage_label": {
            "type": "string",
            "description": "Nome exibido da etapa"
          },
          "item_idx": {
            "type": "number",
            "description": "\u00cdndice do item no pedido"
          },
          "size": {
            "type": "string",
            "description": "Tamanho da treli\u00e7a"
          },
          "unit": {
            "type": "number",
            "description": "N\u00famero da unidade bipada"
          },
          "operator_name": {
            "type": "string",
            "description": "Nome de quem bipou"
          },
          "operator_email": {
            "type": "string",
            "description": "Email de quem bipou"
          },
          "at": {
            "type": "string",
            "description": "Data/hora da bipagem (ISO)"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "order_number",
    "client_name"
  ]
}