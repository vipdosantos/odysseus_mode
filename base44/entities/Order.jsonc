{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero do pedido"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "client_email": {
      "type": "string",
      "description": "E-mail do cliente (para envio do link de status)"
    },
    "client_photo": {
      "type": "string",
      "description": "Foto do cliente (URL)"
    },
    "access_key": {
      "type": "string",
      "description": "Chave de acesso ao status do pedido"
    },
    "seller_id": {
      "type": "string",
      "description": "ID do vendedor"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "seller_phone": {
      "type": "string",
      "description": "Telefone do vendedor"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "orcamento",
        "pedido"
      ],
      "default": "pedido",
      "description": "Tipo: or\u00e7amento (em negocia\u00e7\u00e3o) ou pedido (confirmado)"
    },
    "status": {
      "type": "string",
      "default": "of_etiquetas",
      "description": "Etapa do pedido (chave da coluna Kanban)"
    },
    "quote_tipo_laje": {
      "type": "string",
      "description": "Tipo de laje (or\u00e7amento)",
      "default": "Laje"
    },
    "tipo_enchimento": {
      "type": "string",
      "description": "Tipo de enchimento da laje",
      "default": "Nenhum"
    },
    "validade_dias": {
      "type": "number",
      "description": "Validade do or\u00e7amento em dias",
      "default": 15
    },
    "items": {
      "type": "array",
      "description": "Itens do pedido (treli\u00e7as)",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "l": {
            "type": "number",
            "default": 0,
            "description": "Comprimento de cada treli\u00e7a/vigota (m)"
          },
          "truss_type": {
            "type": "string",
            "enum": [
              "H8",
              "H12",
              "H16",
              "H20",
              "H25",
              "H30"
            ],
            "description": "Tipo de treli\u00e7a"
          },
          "enchimento_dimension": {
            "type": "string",
            "description": "Dimens\u00e3o do enchimento (EPS/Lajota) - auto-preenchido pela tabela",
            "default": ""
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number",
            "default": 0,
            "description": "Pre\u00e7o unit\u00e1rio (or\u00e7amento)"
          },
          "produced": {
            "type": "number",
            "default": 0
          },
          "scanned_units": {
            "type": "array",
            "description": "Unidades j\u00e1 escaneadas na produ\u00e7\u00e3o (n\u00fameros 1..quantity)",
            "items": {
              "type": "number"
            }
          },
          "delivered_units": {
            "type": "array",
            "description": "Unidades conferidas na entrega (n\u00fameros 1..quantity)",
            "items": {
              "type": "number"
            }
          },
          "loaded_units": {
            "type": "array",
            "description": "Unidades conferidas no carregamento do caminh\u00e3o (n\u00fameros 1..quantity)",
            "items": {
              "type": "number"
            },
            "default": []
          },
          "stage_conferencias": {
            "type": "object",
            "description": "Confer\u00eancia por etapa do Kanban: stageKey -> [unidades bipadas]. Cada status exige bipe de todas as unidades para avan\u00e7ar.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "default": {}
          },
          "qr_code_id": {
            "type": "string"
          },
          "adicionais": {
            "type": "array",
            "description": "Ferros adicionais",
            "items": {
              "type": "object",
              "properties": {
                "diametro": {
                  "type": "string",
                  "enum": [
                    "5.0",
                    "6.3",
                    "8.0",
                    "10.0",
                    "12.5"
                  ],
                  "description": "Di\u00e2metro do ferro"
                },
                "quantity": {
                  "type": "number",
                  "default": 0
                }
              }
            }
          }
        }
      }
    },
    "telas": {
      "type": "array",
      "description": "Telas (malhas) do pedido",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "modelo": {
            "type": "string",
            "enum": [
              "Q.45",
              "Q.61",
              "Q.92",
              "Q.138"
            ],
            "description": "Modelo da tela"
          },
          "especificacao": {
            "type": "string",
            "description": "Especifica\u00e7\u00e3o (auto-preenchido)"
          },
          "quantity": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_address": {
      "type": "string",
      "description": "Endere\u00e7o de entrega"
    },
    "delivery_lat": {
      "type": "number",
      "description": "Latitude"
    },
    "delivery_lng": {
      "type": "number",
      "description": "Longitude"
    },
    "truck_type": {
      "type": "string",
      "default": "nenhum",
      "description": "C\u00f3digo do tipo de caminh\u00e3o (vinculado ao cadastro TruckType)"
    },
    "motorista_id": {
      "type": "string",
      "description": "ID do motorista atribu\u00eddo \u00e0 entrega"
    },
    "motorista_name": {
      "type": "string",
      "description": "Nome do motorista atribu\u00eddo \u00e0 entrega"
    },
    "delivery_priority": {
      "type": "number",
      "default": 0,
      "description": "Prioridade de entrega definida pelo admin (maior = entregue primeiro)"
    },
    "total_value": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "boleto",
        "pix",
        "transferencia",
        "cartao",
        "dinheiro",
        "cheque"
      ],
      "default": "boleto",
      "description": "Forma de pagamento (principal)"
    },
    "installments": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de parcelas (principal)"
    },
    "payments": {
      "type": "array",
      "description": "M\u00faltiplas formas de pagamento (forma, valor, parcelas)",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "boleto",
              "pix",
              "transferencia",
              "cartao",
              "dinheiro",
              "cheque"
            ],
            "default": "pix"
          },
          "value": {
            "type": "number",
            "default": 0
          },
          "installments": {
            "type": "number",
            "default": 1
          }
        }
      },
      "default": []
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "normal",
        "alta",
        "urgente"
      ],
      "default": "normal"
    },
    "attachments": {
      "type": "array",
      "description": "Anexos",
      "items": {
        "type": "string"
      }
    },
    "delivery_photos": {
      "type": "array",
      "description": "Fotos da entrega",
      "items": {
        "type": "string"
      }
    },
    "delivery_signature": {
      "type": "string",
      "description": "Assinatura do recebedor (base64 PNG)"
    },
    "delivery_signed_by": {
      "type": "string",
      "description": "Nome do recebedor"
    },
    "delivery_signer_doc": {
      "type": "string",
      "description": "CPF/RG do recebedor"
    },
    "delivery_signed_at": {
      "type": "string",
      "description": "Data/hora da assinatura"
    },
    "delivery_conferido": {
      "type": "boolean",
      "default": false,
      "description": "Confer\u00eancia de entrega conclu\u00edda (todas as treli\u00e7as bipadas)"
    },
    "delivery_conferido_at": {
      "type": "string",
      "description": "Data/hora da confer\u00eancia de entrega"
    },
    "delivery_conferido_by": {
      "type": "string",
      "description": "Quem fez a confer\u00eancia de entrega"
    },
    "delivery_drive_id": {
      "type": "string",
      "description": "ID do recibo de entrega salvo no Google Drive"
    },
    "delivery_drive_link": {
      "type": "string",
      "description": "Link do recibo de entrega no Google Drive"
    },
    "load_conferido": {
      "type": "boolean",
      "default": false,
      "description": "Confer\u00eancia de carregamento do caminh\u00e3o conclu\u00edda (todas as treli\u00e7as bipadas)"
    },
    "load_conferido_at": {
      "type": "string",
      "description": "Data/hora da confer\u00eancia de carregamento"
    },
    "load_conferido_by": {
      "type": "string",
      "description": "Quem fez a confer\u00eancia de carregamento"
    },
    "contract_rg": {
      "type": "string",
      "description": "RG do cliente (contrato)"
    },
    "contract_cpf": {
      "type": "string",
      "description": "CPF do cliente (contrato)"
    },
    "contract_signature": {
      "type": "string",
      "description": "Assinatura do contrato (base64 PNG)"
    },
    "contract_signed_by": {
      "type": "string",
      "description": "Quem assinou o contrato (cliente)"
    },
    "contract_signed_at": {
      "type": "string",
      "description": "Data/hora da assinatura do contrato"
    },
    "contract_drive_id": {
      "type": "string",
      "description": "ID do contrato assinado no Google Drive"
    },
    "contract_drive_link": {
      "type": "string",
      "description": "Link do contrato assinado no Google Drive"
    },
    "contract_link_sent_at": {
      "type": "string",
      "description": "Data/hora em que o link de assinatura do contrato foi enviado"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Or\u00e7amento/pedido arquivado (oculta das listas principais)"
    },
    "scan_log": {
      "type": "array",
      "description": "Log detalhado de cada bipagem (rastreio por etapa)",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "description": "Chave da etapa do Kanban"
          },
          "stage_label": {
            "type": "string",
            "description": "Nome exibido da etapa"
          },
          "item_idx": {
            "type": "number",
            "description": "\u00cdndice do item no pedido"
          },
          "size": {
            "type": "string",
            "description": "Tamanho da treli\u00e7a"
          },
          "unit": {
            "type": "number",
            "description": "N\u00famero da unidade bipada"
          },
          "operator_name": {
            "type": "string",
            "description": "Nome de quem bipou"
          },
          "operator_email": {
            "type": "string",
            "description": "Email de quem bipou"
          },
          "at": {
            "type": "string",
            "description": "Data/hora da bipagem (ISO)"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "order_number",
    "client_name"
  ]
}