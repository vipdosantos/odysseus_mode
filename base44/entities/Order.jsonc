{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero do pedido"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "seller_id": {
      "type": "string",
      "description": "ID do vendedor"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "status": {
      "type": "string",
      "enum": [
        "of_etiquetas",
        "corte_vigas",
        "producao",
        "secagem",
        "expedicao",
        "aguardando_entrega",
        "entrega",
        "a_caminho",
        "recebido",
        "pagamento_pendente",
        "finalizado"
      ],
      "default": "of_etiquetas"
    },
    "items": {
      "type": "array",
      "description": "Itens do pedido (treli\u00e7as)",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "produced": {
            "type": "number",
            "default": 0
          },
          "qr_code_id": {
            "type": "string"
          }
        }
      }
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_address": {
      "type": "string",
      "description": "Endere\u00e7o de entrega"
    },
    "delivery_lat": {
      "type": "number",
      "description": "Latitude"
    },
    "delivery_lng": {
      "type": "number",
      "description": "Longitude"
    },
    "truck_type": {
      "type": "string",
      "enum": [
        "nenhum",
        "moto",
        "van",
        "toco",
        "truck",
        "carreta",
        "bitrem"
      ],
      "default": "nenhum",
      "description": "Tipo de caminh\u00e3o"
    },
    "total_value": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "normal",
        "alta",
        "urgente"
      ],
      "default": "normal"
    },
    "attachments": {
      "type": "array",
      "description": "Anexos (PDF, JPG, Excel)",
      "items": {
        "type": "string"
      }
    },
    "delivery_photos": {
      "type": "array",
      "description": "Fotos da entrega / documentos de recebimento",
      "items": {
        "type": "string"
      }
    },
    "delivery_signature": {
      "type": "string",
      "description": "Assinatura do recebedor (base64 PNG)"
    },
    "delivery_signed_by": {
      "type": "string",
      "description": "Nome do recebedor"
    },
    "delivery_signer_doc": {
      "type": "string",
      "description": "CPF/RG do recebedor"
    },
    "delivery_signed_at": {
      "type": "string",
      "description": "Data/hora da assinatura"
    }
  },
  "required": [
    "order_number",
    "client_name"
  ]
}