{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "pix",
        "conta_bancaria"
      ],
      "default": "pix",
      "description": "Tipo de conta"
    },
    "label": {
      "type": "string",
      "description": "Nome / Apelido da conta"
    },
    "pix_key_type": {
      "type": "string",
      "enum": [
        "cnpj",
        "cpf",
        "email",
        "telefone",
        "aleatoria"
      ],
      "default": "cnpj",
      "description": "Tipo de chave PIX"
    },
    "pix_key": {
      "type": "string",
      "description": "Chave PIX"
    },
    "banco": {
      "type": "string",
      "description": "Nome do banco"
    },
    "agencia": {
      "type": "string",
      "description": "Ag\u00eancia"
    },
    "conta": {
      "type": "string",
      "description": "N\u00famero da conta"
    },
    "titular": {
      "type": "string",
      "description": "Titular da conta"
    },
    "cnpj_cpf": {
      "type": "string",
      "description": "CNPJ / CPF do titular"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Conta ativa"
    },
    "integration_type": {
      "type": "string",
      "enum": [
        "nenhum",
        "bradesco_api_banking",
        "belvo",
        "pluggy"
      ],
      "default": "nenhum",
      "description": "Tipo de integra\u00e7\u00e3o Open Finance / API Banking"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "desconectado",
        "conectado",
        "erro"
      ],
      "default": "desconectado",
      "description": "Status da sincroniza\u00e7\u00e3o com o banco"
    },
    "last_sync_at": {
      "type": "string",
      "description": "Data/hora da \u00faltima sincroniza\u00e7\u00e3o (ISO)"
    },
    "sync_error": {
      "type": "string",
      "description": "Mensagem de erro da \u00faltima sincroniza\u00e7\u00e3o"
    }
  },
  "required": [
    "label",
    "type"
  ]
}