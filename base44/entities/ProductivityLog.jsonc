{
  "name": "ProductivityLog",
  "type": "object",
  "properties": {
    "employee_name": {
      "type": "string",
      "description": "Nome do funcion\u00e1rio"
    },
    "employee_email": {
      "type": "string",
      "description": "Email"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data"
    },
    "order_number": {
      "type": "string",
      "description": "Pedido relacionado"
    },
    "activity": {
      "type": "string",
      "description": "Atividade realizada"
    },
    "quantity_produced": {
      "type": "number",
      "description": "Quantidade produzida",
      "default": 0
    },
    "hours_worked": {
      "type": "number",
      "description": "Horas trabalhadas",
      "default": 8
    },
    "observations": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "rating": {
      "type": "number",
      "description": "Auto-avalia\u00e7\u00e3o (1-5)",
      "default": 3
    }
  },
  "required": [
    "employee_name",
    "date",
    "activity"
  ]
}